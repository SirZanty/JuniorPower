@model List<JuniorPower.Models.StudyDay>
@using System.Text.Json
@{
    ViewData["Title"] = "Plan de Estudio";
}

<div class="mb-4">
    <p class="text-muted">7 días. 8 horas diarias. Un objetivo: convertirte en backend junior sólido.</p>
</div>

<div class="timeline">
    @foreach (var day in Model)
    {
        var objectives = JsonSerializer.Deserialize<string[]>(day.Objectives) ?? Array.Empty<string>();
        var topics = JsonSerializer.Deserialize<string[]>(day.Topics) ?? Array.Empty<string>();
        var errors = JsonSerializer.Deserialize<string[]>(day.ErrorsToProvoke) ?? Array.Empty<string>();
        var completedTasks = day.Tasks.Count(t => t.IsCompleted);
        var totalTasks = day.Tasks.Count;
        var percent = totalTasks > 0 ? (int)((double)completedTasks / totalTasks * 100) : 0;

        <div class="timeline-item">
            <div class="timeline-marker @(completedTasks == totalTasks && totalTasks > 0 ? "timeline-marker--complete" : "")">
                <span>@day.Icon</span>
            </div>
            <div class="timeline-content">
                <div class="timeline-header" data-bs-toggle="collapse" data-bs-target="#day-@day.DayNumber" style="cursor:pointer;">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <span class="day-badge">Día @day.DayNumber</span>
                        <h5 class="mb-0 fw-semibold">@day.Title</h5>
                        @if (completedTasks == totalTasks && totalTasks > 0)
                        {
                            <span class="badge bg-success-subtle text-success">Completado</span>
                        }
                        else if (completedTasks > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning">En progreso</span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <small class="text-muted">@completedTasks/@totalTasks tareas</small>
                        <i class="bi bi-chevron-down text-muted timeline-chevron"></i>
                    </div>
                </div>

                <div class="progress mt-2" style="height: 2px;">
                    <div class="progress-bar bg-accent" style="width: @percent%"></div>
                </div>

                <div class="collapse show" id="day-@day.DayNumber">
                    <div class="timeline-body">
                        <p class="text-muted mb-3">@day.Description</p>

                        <div class="plan-grid">
                            <!-- Objetivos -->
                            <div class="plan-section">
                                <h6 class="plan-section-title"><i class="bi bi-bullseye text-accent"></i> Objetivos</h6>
                                <ul class="plan-list">
                                    @foreach (var obj in objectives)
                                    {
                                        <li>@obj</li>
                                    }
                                </ul>
                            </div>

                            <!-- Temas -->
                            <div class="plan-section">
                                <h6 class="plan-section-title"><i class="bi bi-book text-info"></i> Temas</h6>
                                <ul class="plan-list">
                                    @foreach (var topic in topics)
                                    {
                                        <li>@topic</li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <!-- Proyecto -->
                        <div class="project-box">
                            <div class="project-box-header">
                                <i class="bi bi-code-square text-accent"></i>
                                <span class="fw-semibold">Proyecto del Día</span>
                                <span class="text-accent fw-bold">@day.ProjectName</span>
                            </div>
                            <p class="mb-0 text-muted">@day.ProjectDescription</p>
                        </div>

                        <!-- Errores a provocar -->
                        <div class="errors-box">
                            <div class="errors-box-header">
                                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                <span class="fw-semibold text-warning">Errores que DEBES provocar</span>
                            </div>
                            <ul class="plan-list">
                                @foreach (var error in errors)
                                {
                                    <li><code>@error</code></li>
                                }
                            </ul>
                        </div>

                        <!-- Meta del día -->
                        <div class="goal-box">
                            <i class="bi bi-trophy-fill text-accent"></i>
                            <div>
                                <strong>Meta del día:</strong>
                                <span class="text-muted">@day.DayGoal</span>
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <a href="/StudyPlan/Day/@day.DayNumber" class="btn btn-accent btn-sm">
                                <i class="bi bi-arrow-right-circle"></i> Ver detalle completo
                            </a>
                            <a href="/Tasks?day=@day.DayNumber" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-check2-square"></i> Ver tareas
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
